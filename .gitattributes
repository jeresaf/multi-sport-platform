# Normalise line endings to LF in the repository and working tree.
* text=auto eol=lf

# Windows scripts need CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.xlsx binary
