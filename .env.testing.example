# Hosted tests normally inject these settings from ApiWebApplicationFactory.
# Use this inventory when running a standalone test API process.
ASPNETCORE_ENVIRONMENT=Testing
Database__ConnectionString=unused-in-memory
Tenant__DefaultConnectionString=unused-in-memory
Jwt__Secret=replace-with-at-least-32-test-only-bytes
Jwt__Issuer=SportsPlatform
Jwt__Audience=SportsPlatformUsers

