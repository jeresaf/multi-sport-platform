# Copy to .env for the root development Docker Compose stack.
# Values below are examples only; replace every replace-with-* value.
DB_PASSWORD=replace-with-a-local-database-password
JWT_SECRET=replace-with-at-least-32-random-utf8-bytes
PGADMIN_PASSWORD=replace-with-a-local-pgadmin-password

# Optional browser URL for the administration sign-in handoff.
# Leave blank on LAN development so the public web uses its current hostname on port 3000.
NEXT_PUBLIC_ADMIN_URL=
