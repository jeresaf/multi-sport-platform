# Local development only. Copy to .env (git-ignored): cp .env.example .env
# These passwords protect nothing real — never reuse them outside your machine.

# PostgreSQL (docker compose)
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=postgres-dev-only
SP_MIGRATOR_PASSWORD=sp-migrator-dev-only
SP_APP_PASSWORD=sp-app-dev-only
SP_PLATFORM_PASSWORD=sp-platform-dev-only

# Mailpit (SMTP 1025, web UI http://localhost:8025)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Aspire dashboard (only with: docker compose --profile observability up -d)
ASPIRE_UI_PORT=18888
OTLP_GRPC_PORT=4317

# Connection strings used by the backend from S01 (shown here for reference):
# Host=localhost;Port=5432;Database=sportsplatform;Username=sp_app;Password=sp-app-dev-only
# Host=localhost;Port=5432;Database=sportsplatform;Username=sp_migrator;Password=sp-migrator-dev-only
