{
  "name": "@msp/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./admin": "./src/admin.ts",
    "./errors": "./src/errors.ts"
  },
  "scripts": {
    "generate": "openapi-typescript ../../../contracts/openapi.json --output src/generated/schema.ts && node -e \"require('node:fs').copyFileSync('../../../contracts/errors.json','src/generated/errors.json')\"",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@msp/config": "workspace:*",
    "eslint": "9.39.5",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
