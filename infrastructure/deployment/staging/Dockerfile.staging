# The build context for this file must be the repository root.
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY . .
RUN dotnet restore apps/api/SportsPlatform.Api.csproj
RUN dotnet publish apps/api/SportsPlatform.Api.csproj \
    --configuration Release \
    --no-restore \
    --output /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install --yes --no-install-recommends curl fonts-dejavu-core coreutils tar gzip \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /app/logs

COPY --from=build /app/publish .
COPY infrastructure/deployment/staging/seed-pack/public-csv-seed.part-01.b64 /tmp/public-csv-seed.part-01.b64
COPY infrastructure/deployment/staging/seed-pack/public-csv-seed.part-02.b64 /tmp/public-csv-seed.part-02.b64
COPY infrastructure/deployment/staging/seed-pack/public-csv-seed.part-03.b64 /tmp/public-csv-seed.part-03.b64

# The public staging dataset is versioned with the repository so clean CI runners
# and local Docker staging use the exact same deterministic source. Reconstruct
# it at image-build time and fail the build immediately if the numbered pack is
# incomplete rather than letting the API fail later during startup.
RUN mkdir -p /app/seed-data \
    && cat /tmp/public-csv-seed.part-01.b64 \
           /tmp/public-csv-seed.part-02.b64 \
           /tmp/public-csv-seed.part-03.b64 \
       | base64 --decode \
       | tar -xzf - -C /app/seed-data \
    && rm -f /tmp/public-csv-seed.part-*.b64 \
    && test -f /app/seed-data/01_tenants.csv \
    && test -f /app/seed-data/10_contests.csv \
    && test -f /app/seed-data/11_contest_participants.csv \
    && test -f /app/seed-data/18_presentation_metadata.csv \
    && test -f /app/seed-data/19_sponsors.csv \
    && test "$(find /app/seed-data -maxdepth 1 -type f -name '[0-9][0-9]_*.csv' | wc -l)" -eq 19

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Staging
ENV DOTNET_EnableDiagnostics=0

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl --fail http://localhost:8080/health/live || exit 1

ENTRYPOINT ["dotnet", "SportsPlatform.Api.dll"]
