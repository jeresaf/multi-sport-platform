# Copy to .env.staging. Never commit .env.staging.
DB_PASSWORD=replace-with-a-strong-staging-database-password
DB_HOST_PORT=5434
JWT_SECRET=replace-with-at-least-32-random-utf8-bytes
JWT_PREVIOUS_SECRET=

# Use distinct credentials during the next planned credential rotation.
MINIO_ROOT_USER=sportsplatform
MINIO_ROOT_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

API_BASE_URL=http://localhost:8080
FRONTEND_BASE_URL=http://localhost:3000
ENABLE_SWAGGER=false
ENABLE_DETAILED_ERRORS=false
LOG_LEVEL=Information
LOG_RETENTION_DAYS=30
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@staging.invalid
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
STORAGE_CONNECTION_STRING=
STORAGE_CONTAINER_NAME=reports

