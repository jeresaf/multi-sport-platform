{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1, "type": "stat", "title": "API health",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sportsplatform_api_up", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } }, "type": "value" }], "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "value_and_name" }
    },
    {
      "id": 2, "type": "stat", "title": "Database health",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sportsplatform_dependency_health{dependency=\"postgresql\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "value_and_name" }
    },
    {
      "id": 3, "type": "stat", "title": "Redis health",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sportsplatform_dependency_health{dependency=\"redis\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "value_and_name" }
    },
    {
      "id": 4, "type": "stat", "title": "Active SignalR connections",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sportsplatform_signalr_connections{tenant_id=\"all\"}", "refId": "A" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "value_and_name" }
    },
    {
      "id": 5, "type": "timeseries", "title": "Report queue backlog by tenant",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sportsplatform_queue_backlog{queue=\"reports\",tenant_id=~\"$tenant\"}", "legendFormat": "{{tenant_id}}", "refId": "A" }],
      "fieldConfig": { "defaults": {}, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Failed report jobs by tenant",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sportsplatform_failed_jobs{queue=\"reports\",tenant_id=~\"$tenant\"}", "legendFormat": "{{tenant_id}}", "refId": "A" }],
      "fieldConfig": { "defaults": {}, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 7, "type": "timeseries", "title": "Notification failures by tenant",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sportsplatform_notification_failures{tenant_id=~\"$tenant\"}", "legendFormat": "{{tenant_id}}", "refId": "A" }],
      "fieldConfig": { "defaults": {}, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 8, "type": "timeseries", "title": "Tenant usage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sportsplatform_tenant_usage{tenant_id=~\"$tenant\"}", "legendFormat": "{{tenant_id}} · {{metric}}", "refId": "A" }],
      "fieldConfig": { "defaults": {}, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 9, "type": "timeseries", "title": "API error rate",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(sportsplatform_http_requests_total{status_code=~\"5..\",tenant_id=~\"$tenant\"}[5m])) / clamp_min(sum(rate(sportsplatform_http_requests_total{tenant_id=~\"$tenant\"}[5m])), 0.001)", "legendFormat": "5xx rate", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.05 }] } }, "overrides": [] }, "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["sportsplatform", "operations"],
  "templating": { "list": [{ "name": "tenant", "label": "Tenant", "type": "query", "datasource": { "type": "prometheus", "uid": "prometheus" }, "query": { "query": "label_values(sportsplatform_tenant_usage, tenant_id)", "refId": "PrometheusVariableQueryEditor-VariableQuery" }, "includeAll": true, "allValue": ".*", "multi": true, "current": { "text": "All", "value": "$__all" } }] },
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "browser",
  "title": "SportsPlatform Operations",
  "uid": "sportsplatform-operations",
  "version": 1
}
