<Project Sdk="Microsoft.NET.Sdk">

  <!-- ASP.NET Core is used only by the .Modules (IModule) and .Api (Result → HTTP) namespaces; architecture tests enforce it. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Request-shape validators (Apache-2.0); run by RequestValidationExtensions in the .Api namespace. -->
  <ItemGroup>
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

</Project>
