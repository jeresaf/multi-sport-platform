{
  "openapi": "3.1.1",
  "info": {
    "title": "MSP API",
    "description": "Multi-sport competition platform. Errors are Problem Details with a stable `code` (contracts/errors.json) and the request's `correlationId`.",
    "version": "v1"
  },
  "paths": {
    "/api/public/v1/reference/countries": {
      "get": {
        "tags": [
          "Reference"
        ],
        "summary": "List countries",
        "description": "Active ISO 3166-1 countries, ordered by alpha-2 code. Cacheable for an hour; send the `ETag` back as `If-None-Match` to get 304.",
        "operationId": "ListCountries",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListCountriesResponse"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified"
          }
        }
      }
    },
    "/api/public/v1/reference/currencies": {
      "get": {
        "tags": [
          "Reference"
        ],
        "summary": "List currencies",
        "description": "Active ISO 4217 currencies (money only), ordered by code, with their minor units. Cacheable for an hour; send the `ETag` back as `If-None-Match` to get 304.",
        "operationId": "ListCurrencies",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListCurrenciesResponse"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified"
          }
        }
      }
    },
    "/api/public/v1/reference/languages": {
      "get": {
        "tags": [
          "Reference"
        ],
        "summary": "List languages",
        "description": "Active ISO 639-1 languages, ordered by code. Cacheable for an hour; send the `ETag` back as `If-None-Match` to get 304.",
        "operationId": "ListLanguages",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListLanguagesResponse"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified"
          }
        }
      }
    },
    "/api/public/v1/reference/time-zones": {
      "get": {
        "tags": [
          "Reference"
        ],
        "summary": "List time zones",
        "description": "Active IANA time zones, ordered by ID. `country` (ISO 3166-1 alpha-2, upper case) keeps only that country's zones; a country without zones gives an empty list. Cacheable for an hour; send the `ETag` back as `If-None-Match` to get 304.",
        "operationId": "ListTimeZones",
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListTimeZonesResponse"
                }
              }
            }
          },
          "304": {
            "description": "Not Modified"
          },
          "400": {
            "description": "Problem Details; `code`: `VALIDATION_INVALID_QUERY`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "VALIDATION_INVALID_QUERY"
            ]
          }
        }
      }
    },
    "/api/platform/v1/diagnostics/outbox": {
      "get": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "List outbox messages",
        "description": "Outbox messages of every module, newest first, without their payloads. Filter by `module` (a module schema) and `status` (PENDING, PROCESSED or FAILED); `limit` is 1–100 (25). `heldBackBy` names the earlier message a PENDING one waits for.",
        "operationId": "ListOutboxMessages",
        "parameters": [
          {
            "name": "module",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListOutboxMessagesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; `code`: `VALIDATION_INVALID_QUERY`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "VALIDATION_INVALID_QUERY"
            ]
          }
        }
      }
    },
    "/api/platform/v1/diagnostics/outbox/{module}/{messageId}/redrive": {
      "post": {
        "tags": [
          "Diagnostics"
        ],
        "summary": "Re-drive a failed outbox message",
        "description": "Moves one FAILED message back to PENDING with its attempts reset; the processor delivers it on its next poll. Fix the cause first: a message that fails again ends FAILED again. The reason is kept permanently in the audit trail: don't include personal data.",
        "operationId": "RedriveOutboxMessage",
        "parameters": [
          {
            "name": "module",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedriveOutboxMessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OutboxMessageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; `code`: `VALIDATION_REASON_REQUIRED`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "VALIDATION_REASON_REQUIRED"
            ]
          },
          "404": {
            "description": "Problem Details; `code`: `PLATFORM_OUTBOX_MESSAGE_NOT_FOUND`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "PLATFORM_OUTBOX_MESSAGE_NOT_FOUND"
            ]
          },
          "409": {
            "description": "Problem Details; `code`: `PLATFORM_OUTBOX_MESSAGE_NOT_FAILED`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "PLATFORM_OUTBOX_MESSAGE_NOT_FAILED"
            ]
          }
        }
      }
    },
    "/api/platform/v1/audit-entries": {
      "get": {
        "tags": [
          "Audit"
        ],
        "summary": "List audit entries",
        "description": "Audit entries of every tenant, newest first. Filter by `tenantId`, `actorId`, `action` (an action code), `entityType` and `entityId` (`entityId` needs `entityType`), `correlationId`, `outcome` (SUCCESS, FAILURE or DENIED), and `from` (inclusive) / `to` (exclusive), ISO 8601 instants with an offset (encode `+` as `%2B`); `limit` is 1–100 (25). Entries recorded through a module's outbox arrive shortly after the action, so one can appear before a page already read. Every page read is itself audited: don't poll this list.",
        "operationId": "ListAuditEntries",
        "parameters": [
          {
            "name": "tenantId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "actorId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "action",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entityType",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entityId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "correlationId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "outcome",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListAuditEntriesResponse"
                }
              }
            }
          },
          "400": {
            "description": "Problem Details; `code`: `VALIDATION_INVALID_QUERY`",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "x-error-codes": [
              "VALIDATION_INVALID_QUERY"
            ]
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActorKind": {
        "enum": [
          "USER",
          "SYSTEM"
        ]
      },
      "AuditEntryResponse": {
        "required": [
          "id",
          "occurredAt",
          "actionCode",
          "outcome",
          "errorCode",
          "actorKind",
          "actorId",
          "tenantId",
          "entityType",
          "entityId",
          "source",
          "correlationId",
          "reason",
          "metadata"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "actionCode": {
            "type": "string"
          },
          "outcome": {
            "$ref": "#/components/schemas/AuditOutcome"
          },
          "errorCode": {
            "type": [
              "null",
              "string"
            ]
          },
          "actorKind": {
            "$ref": "#/components/schemas/ActorKind"
          },
          "actorId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "entityType": {
            "type": [
              "null",
              "string"
            ]
          },
          "entityId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "source": {
            "$ref": "#/components/schemas/AuditSource"
          },
          "correlationId": {
            "type": [
              "null",
              "string"
            ]
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "metadata": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JsonElement"
              }
            ]
          }
        },
        "description": "One audit entry as platform staff see it: every column, with `metadata` as the JSON object it was stored as\n(personal data already masked when it was recorded)."
      },
      "AuditOutcome": {
        "enum": [
          "SUCCESS",
          "FAILURE",
          "DENIED"
        ],
        "description": "How an audited action ended."
      },
      "AuditSource": {
        "enum": [
          "API",
          "SYSTEM"
        ],
        "description": "Where the action came from."
      },
      "CountryResponse": {
        "required": [
          "code",
          "alpha3Code",
          "numericCode",
          "name"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "alpha3Code": {
            "type": "string"
          },
          "numericCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "description": "An ISO 3166-1 country: alpha-2 `code` (`UG`), alpha-3, numeric code and English name."
      },
      "CurrencyResponse": {
        "required": [
          "code",
          "numericCode",
          "name",
          "minorUnits"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "numericCode": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "minorUnits": {
            "type": "integer",
            "format": "int32"
          }
        },
        "description": "An ISO 4217 currency: alphabetic `code` (`UGX`), numeric code, English name, minor units (UGX 0)."
      },
      "JsonElement": { },
      "LanguageResponse": {
        "required": [
          "code",
          "name"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "description": "An ISO 639-1 language: two-letter `code` (`sw`) and English name."
      },
      "ListAuditEntriesResponse": {
        "required": [
          "items",
          "page"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntryResponse"
            }
          },
          "page": {
            "$ref": "#/components/schemas/PageInfo"
          }
        }
      },
      "ListCountriesResponse": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CountryResponse"
            }
          }
        }
      },
      "ListCurrenciesResponse": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurrencyResponse"
            }
          }
        }
      },
      "ListLanguagesResponse": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LanguageResponse"
            }
          }
        }
      },
      "ListOutboxMessagesResponse": {
        "required": [
          "items",
          "page"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OutboxMessageResponse"
            }
          },
          "page": {
            "$ref": "#/components/schemas/PageInfo"
          }
        }
      },
      "ListTimeZonesResponse": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeZoneResponse"
            }
          }
        }
      },
      "OutboxMessageResponse": {
        "required": [
          "module",
          "id",
          "sequence",
          "eventName",
          "eventVersion",
          "aggregateType",
          "aggregateId",
          "tenantId",
          "correlationId",
          "occurredAt",
          "status",
          "attempts",
          "nextAttemptAt",
          "lastError",
          "processedAt",
          "heldBackBy"
        ],
        "type": "object",
        "properties": {
          "module": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "sequence": {
            "type": "integer",
            "format": "int64"
          },
          "eventName": {
            "type": "string"
          },
          "eventVersion": {
            "type": "integer",
            "format": "int32"
          },
          "aggregateType": {
            "type": "string"
          },
          "aggregateId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "correlationId": {
            "type": [
              "null",
              "string"
            ]
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/OutboxMessageStatus"
          },
          "attempts": {
            "type": "integer",
            "format": "int32"
          },
          "nextAttemptAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastError": {
            "type": [
              "null",
              "string"
            ]
          },
          "processedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "heldBackBy": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        },
        "description": "One outbox message in the platform diagnostics: envelope and delivery state, no payload. `heldBackBy` is set on\na `PENDING` message that waits for an earlier, not yet processed message of its aggregate."
      },
      "OutboxMessageStatus": {
        "enum": [
          "PENDING",
          "PROCESSED",
          "FAILED"
        ],
        "description": "Delivery status of an outbox message (docs/domain/state-machines.md, \"Outbox message\")."
      },
      "PageInfo": {
        "required": [
          "nextCursor",
          "hasMore"
        ],
        "type": "object",
        "properties": {
          "nextCursor": {
            "type": [
              "null",
              "string"
            ]
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "description": "The `page` member of a cursor-paginated list (docs/architecture/api-conventions.md): pass\nNextCursor as `cursor` to get the next page; it is null on the last page."
      },
      "ProblemDetails": {
        "required": [
          "code",
          "correlationId"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "code": {
            "type": "string",
            "description": "Stable error code, `<AREA>_<CONDITION>` (contracts/errors.json). Clients branch on it."
          },
          "correlationId": {
            "type": "string",
            "description": "The request's correlation ID (also the `X-Correlation-Id` response header)."
          },
          "errors": {
            "type": "array",
            "items": {
              "required": [
                "field",
                "code"
              ],
              "type": "object",
              "properties": {
                "field": {
                  "type": "string"
                },
                "code": {
                  "type": "string"
                }
              }
            },
            "description": "Validation failures, one per field: `field` (camelCase) and `code`."
          }
        }
      },
      "RedriveOutboxMessageRequest": {
        "required": [
          "reason"
        ],
        "type": "object",
        "properties": {
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "Why the message is re-driven; the audit entry records it (action audit `REQUIRED_WITH_REASON`). Kept permanently\nand not redacted, so it must not contain personal data."
      },
      "TimeZoneResponse": {
        "required": [
          "code",
          "countryCode"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "countryCode": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "description": "An IANA time zone: its ID as `code` (`Africa/Kampala`) and its country; no country for `Etc/UTC`."
      }
    }
  },
  "tags": [
    {
      "name": "Reference"
    },
    {
      "name": "Diagnostics"
    },
    {
      "name": "Audit"
    }
  ]
}
