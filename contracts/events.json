{
  "events": [
    {
      "name": "AuditRecorded",
      "version": 1,
      "module": "Platform",
      "payload": [
        {
          "name": "entryId",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "actionCode",
          "type": "string",
          "nullable": false
        },
        {
          "name": "outcome",
          "type": "string (enum AuditOutcome: SUCCESS | FAILURE | DENIED)",
          "nullable": false
        },
        {
          "name": "errorCode",
          "type": "string",
          "nullable": true
        },
        {
          "name": "actorKind",
          "type": "string (enum ActorKind: USER | SYSTEM | ANONYMOUS)",
          "nullable": false
        },
        {
          "name": "actorId",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "tenantId",
          "type": "uuid",
          "nullable": true
        },
        {
          "name": "entityType",
          "type": "string",
          "nullable": true
        },
        {
          "name": "entityId",
          "type": "uuid",
          "nullable": true
        },
        {
          "name": "occurredAt",
          "type": "instant",
          "nullable": false
        },
        {
          "name": "source",
          "type": "string (enum AuditSource: API | SYSTEM)",
          "nullable": false
        },
        {
          "name": "correlationId",
          "type": "string",
          "nullable": true
        },
        {
          "name": "reason",
          "type": "string",
          "nullable": true
        },
        {
          "name": "metadata",
          "type": "string",
          "nullable": true
        }
      ],
      "consumers": [
        "platform.audit"
      ]
    },
    {
      "name": "InvitationIssued",
      "version": 1,
      "module": "Identity",
      "payload": [
        {
          "name": "invitationId",
          "type": "uuid",
          "nullable": false
        }
      ],
      "consumers": [
        "identity.invitation_email"
      ]
    },
    {
      "name": "PasswordResetRequested",
      "version": 1,
      "module": "Identity",
      "payload": [
        {
          "name": "userId",
          "type": "uuid",
          "nullable": false
        }
      ],
      "consumers": [
        "identity.password_reset_email"
      ]
    },
    {
      "name": "TenantCreated",
      "version": 1,
      "module": "Tenancy",
      "payload": [
        {
          "name": "tenantId",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "slug",
          "type": "string",
          "nullable": false
        },
        {
          "name": "status",
          "type": "string (enum TenantStatus: PROVISIONING | ACTIVE | SUSPENDED | ARCHIVED)",
          "nullable": false
        }
      ],
      "consumers": []
    },
    {
      "name": "TenantStatusChanged",
      "version": 1,
      "module": "Tenancy",
      "payload": [
        {
          "name": "tenantId",
          "type": "uuid",
          "nullable": false
        },
        {
          "name": "from",
          "type": "string (enum TenantStatus: PROVISIONING | ACTIVE | SUSPENDED | ARCHIVED)",
          "nullable": false
        },
        {
          "name": "to",
          "type": "string (enum TenantStatus: PROVISIONING | ACTIVE | SUSPENDED | ARCHIVED)",
          "nullable": false
        }
      ],
      "consumers": []
    }
  ]
}
