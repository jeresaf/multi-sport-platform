# Inventory for the production secret/configuration provider.
# Do not copy this file unchanged into a production environment.
ASPNETCORE_ENVIRONMENT=Production
SeedData__EnableDemoData=false
Observability__ServiceName=sports-platform-api
Database__ConnectionString=Host=db.example;Port=5432;Database=sports_platform;Username=sports_app;Password=replace-with-a-strong-distinct-password
Database__RedisConnectionString=redis.example:6379,password=replace-with-a-redis-password,ssl=true
Database__EnableDetailedErrors=false
Database__EnableSensitiveDataLogging=false
Tenant__DefaultConnectionString=Host=db.example;Port=5432;Database=sports_platform;Username=sports_app;Password=replace-with-a-strong-distinct-password
Jwt__Secret=replace-with-at-least-32-random-utf8-bytes
Jwt__PreviousSecrets__0=
Jwt__Issuer=SportsPlatform
Jwt__Audience=SportsPlatformUsers
Security__AllowedOrigins__0=https://admin.example.com
Security__AllowedOrigins__1=https://www.example.com
Security__DataProtectionKeyPath=/run/sports-platform/data-protection
Storage__Endpoint=https://objects.example.com
Storage__AccessKey=replace-with-a-storage-access-key
Storage__SecretKey=replace-with-a-secret-distinct-from-the-database-password
Storage__Bucket=sports-platform
Email__Host=smtp.example.com
Email__Port=587
Email__UseTls=true
Email__Username=replace-with-an-smtp-user
Email__Password=replace-with-an-smtp-password
Email__FromAddress=no-reply@example.com
Email__AdminWebBaseUrl=https://admin.example.com
Firebase__ProjectId=
Firebase__CredentialsPath=
