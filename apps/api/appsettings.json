{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "RedisConnectionString": "localhost:6379",
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false,
    "CommandTimeout": 30,
    "MaxRetryCount": 3,
    "MaxRetryDelay": 10
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "SportsPlatform",
    "Audience": "SportsPlatform",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Tenant": {
    "DefaultConnectionString": "",
    "EnableMultiTenancy": true,
    "TenantResolutionStrategy": "Header",
    "TenantHeaderName": "X-Tenant-Id"
  },
  "SeedData": {
    "EnableDemoData": false
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "UseTls": false,
    "FromAddress": "no-reply@sportsplatform.local",
    "AdminWebBaseUrl": "http://localhost:3000"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "Observability": {
    "ServiceName": "sports-platform-api"
  }
}
